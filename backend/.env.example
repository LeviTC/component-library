PORT=4000
# Copia este archivo a .env y sustituye <TU_PASSWORD> por la contraseña del usuario de Atlas.
# Si la contraseña tiene caracteres especiales (@ # : / etc.), codifícala: encodeURIComponent en consola.
# Base de datos: /component-library (puedes cambiar el nombre del path si quieres otra DB).
MONGODB_URI=mongodb+srv://<TU_USER>:<TU_PASSWORD>@component-library-clust.pz0nlhr.mongodb.net/component-library?retryWrites=true&w=majority&appName=component-library-cluster

# Secreto para firmar JWT (mín. 32 caracteres en producción)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Origen del frontend (CORS)
CORS_ORIGIN=http://localhost:3000
